# Copy this file to .env and fill in your real values.
# Get these from the Firebase Console: Project settings > General > Your apps > SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
# Note: this is exposed in the browser bundle in this demo setup. For production,
# move Gemini calls behind a Firebase Cloud Function (see /functions) so the key stays server-side.
VITE_GEMINI_API_KEY=
