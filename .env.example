# Copy this file to .env.local and fill in your real values.
# IMPORTANT: Never commit .env.local to version control!

# ============ Supabase Configuration ============
# Get these from https://app.supabase.com/project/{your-project}/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============ AI Provider Configuration ============
# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
# Note: For production, move Gemini calls behind a server (Cloud Function/API)
VITE_GEMINI_API_KEY=

# OpenAI-compatible API (for multi-provider ZAB AI support)
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=

# AI provider preference: auto | openai | gemini
VITE_ZAB_AI_PROVIDER=auto

# ============ Firebase Configuration (Optional - Legacy) ============
# Get these from the Firebase Console: Project settings > General > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
