rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read/write only their own profile document.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Clubs are publicly readable; writes restricted to admins (manage via console/Cloud Functions for now).
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if false;

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == memberId;
      }
    }

    // Tutors are publicly readable; writes restricted (admin-managed).
    match /tutors/{tutorId} {
      allow read: if true;
      allow write: if false;
    }

    // Bookings: a user can create their own and read only their own.
    match /bookings/{bookingId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Sessions library is publicly readable; writes restricted (admin-managed).
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if false;
    }

    // Community projects are publicly readable; writes restricted (admin-managed).
    match /projects/{projectId} {
      allow read: if true;
      allow write: if false;

      match /contributions/{contributionId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      }
    }
  }
}
